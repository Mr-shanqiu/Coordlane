{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Mr-shanqiu/Coordlane/main/schemas/ownership.schema.json",
  "title": "Coordlane ownership ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mission_id", "claims"],
  "properties": {
    "schema_version": { "const": "1.2.0" },
    "mission_id": { "$ref": "#/$defs/id" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "assignment_id", "resource", "canonical_resource", "owner", "ownership_epoch", "mode", "state", "release"],
        "properties": {
          "claim_id": { "$ref": "#/$defs/id" },
          "assignment_id": { "$ref": "#/$defs/id" },
          "resource": { "$ref": "#/$defs/nonEmpty" },
          "canonical_resource": { "$ref": "#/$defs/nonEmpty" },
          "owner": { "$ref": "#/$defs/id" },
          "ownership_epoch": { "type": "integer", "minimum": 1 },
          "mode": { "enum": ["exclusive", "shared-entrypoint", "integration"] },
          "state": { "enum": ["reserved", "active", "release_pending", "released"] },
          "release": { "$ref": "#/$defs/release" }
        },
        "allOf": [
          {
            "if": { "properties": { "state": { "const": "released" } }, "required": ["state"] },
            "then": {
              "properties": {
                "release": {
                  "type": "object",
                  "properties": {
                    "commit_disposition": { "const": true },
                    "workspace_checked": { "const": true },
                    "validation_recorded": { "const": true },
                    "no_more_edits": { "const": true },
                    "overlap_checked": { "const": true },
                    "runtime_state_recorded": { "const": true },
                    "captain_confirmed": { "const": true }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_disposition", "workspace_checked", "validation_recorded", "no_more_edits", "overlap_checked", "runtime_state_recorded", "captain_confirmed"],
      "properties": {
        "commit_disposition": { "type": "boolean" },
        "workspace_checked": { "type": "boolean" },
        "validation_recorded": { "type": "boolean" },
        "no_more_edits": { "type": "boolean" },
        "overlap_checked": { "type": "boolean" },
        "runtime_state_recorded": { "type": "boolean" },
        "captain_confirmed": { "type": "boolean" }
      }
    }
  }
}
