{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Mr-shanqiu/Coordlane/main/schemas/ledger.schema.json",
  "title": "Coordlane coordinator consumption ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "event_sequence", "freshness", "last_sweep_at", "last_sweep_cursor", "unread_terminal_count", "pending_attention_count", "final_gate_passed", "turn_gate", "workers"],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "project_id": { "$ref": "#/$defs/id" },
    "event_sequence": { "type": "integer", "minimum": 0 },
    "freshness": { "enum": ["fresh", "stale", "unknown"] },
    "last_sweep_at": { "type": ["string", "null"], "format": "date-time" },
    "last_sweep_cursor": { "type": "integer", "minimum": 0 },
    "unread_terminal_count": { "type": "integer", "minimum": 0 },
    "pending_attention_count": { "type": "integer", "minimum": 0 },
    "final_gate_passed": { "type": "boolean" },
    "turn_gate": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["turn_id", "registry_revision", "required_workers", "entry_sweep", "pre_final_sweep", "snapshot_calls_used", "snapshot_call_limit", "scan_limit_reached", "registry_changed", "started_at"],
          "properties": {
            "turn_id": { "$ref": "#/$defs/nonEmpty" },
            "registry_revision": { "type": "integer", "minimum": 0 },
            "required_workers": { "$ref": "#/$defs/workerAddresses" },
            "entry_sweep": { "$ref": "#/$defs/sweepPhase" },
            "pre_final_sweep": { "$ref": "#/$defs/sweepPhase" },
            "snapshot_calls_used": { "type": "integer", "minimum": 0 },
            "snapshot_call_limit": { "type": "integer", "minimum": 2 },
            "scan_limit_reached": { "type": "boolean" },
            "registry_changed": { "type": "boolean" },
            "started_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["worker_id", "last_seen_cursor", "last_discovered_revision", "last_consumed_revision", "last_validated_revision", "active_assignment_id", "origin", "consumed_event_ids", "attention"],
        "properties": {
          "worker_id": { "$ref": "#/$defs/id" },
          "last_seen_cursor": { "type": "integer", "minimum": 0 },
          "last_discovered_revision": { "type": "integer", "minimum": 0 },
          "last_consumed_revision": { "type": "integer", "minimum": 0 },
          "last_validated_revision": { "type": "integer", "minimum": 0 },
          "active_assignment_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
          "origin": { "enum": ["coordinator", "user_direct", "external"] },
          "consumed_event_ids": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" }, "uniqueItems": true },
          "attention": { "oneOf": [{ "$ref": "#/$defs/attention" }, { "type": "null" }] }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "attention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attention_id", "kind", "state", "worker_id", "assignment_id", "attempt_id", "thread_id", "host_id", "turn_id", "tool_name", "sanitized_reason", "request_digest", "detected_at", "surfaced_turn_id", "resolved_at"],
      "properties": {
        "attention_id": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "const": "approval_required" },
        "state": { "enum": ["pending", "resolved"] },
        "worker_id": { "$ref": "#/$defs/id" },
        "assignment_id": { "$ref": "#/$defs/id" },
        "attempt_id": { "$ref": "#/$defs/id" },
        "thread_id": { "$ref": "#/$defs/nonEmpty" },
        "host_id": { "$ref": "#/$defs/nonEmpty" },
        "turn_id": { "type": ["string", "null"], "minLength": 1 },
        "tool_name": { "$ref": "#/$defs/nonEmpty" },
        "sanitized_reason": { "$ref": "#/$defs/nonEmpty" },
        "request_digest": { "$ref": "#/$defs/digest" },
        "detected_at": { "type": "string", "format": "date-time" },
        "surfaced_turn_id": { "type": ["string", "null"], "minLength": 1 },
        "resolved_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "workerAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_id", "thread_id", "host_id"],
      "properties": {
        "worker_id": { "$ref": "#/$defs/id" },
        "thread_id": { "$ref": "#/$defs/nonEmpty" },
        "host_id": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "workerAddresses": {
      "type": "array",
      "items": { "$ref": "#/$defs/workerAddress" }
    },
    "sweepPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_workers", "completed_at"],
      "properties": {
        "observed_workers": { "$ref": "#/$defs/workerAddresses" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
