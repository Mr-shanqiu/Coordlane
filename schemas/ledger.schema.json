{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Mr-shanqiu/Coordlane/main/schemas/ledger.schema.json",
  "title": "Coordlane coordinator consumption ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "event_sequence", "freshness", "last_sweep_at", "last_sweep_cursor", "unread_terminal_count", "final_gate_passed", "heartbeat", "workers"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "project_id": { "$ref": "#/$defs/id" },
    "event_sequence": { "type": "integer", "minimum": 0 },
    "freshness": { "enum": ["fresh", "stale", "unknown"] },
    "last_sweep_at": { "type": ["string", "null"], "format": "date-time" },
    "last_sweep_cursor": { "type": "integer", "minimum": 0 },
    "unread_terminal_count": { "type": "integer", "minimum": 0 },
    "final_gate_passed": { "type": "boolean" },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["broker", "status", "sla_seconds", "monitored_running_count", "last_probe_at", "last_probe_cursor", "wake_required", "last_wake_reason", "liveness_mode"],
      "properties": {
        "broker": { "enum": ["codex_heartbeat", "event_broker", null] },
        "status": { "enum": ["stopped", "armed", "unavailable"] },
        "sla_seconds": { "type": ["integer", "null"], "minimum": 10 },
        "monitored_running_count": { "type": "integer", "minimum": 0 },
        "last_probe_at": { "type": ["string", "null"], "format": "date-time" },
        "last_probe_cursor": { "type": "integer", "minimum": 0 },
        "wake_required": { "type": "boolean" },
        "last_wake_reason": { "enum": ["unread_terminal", "event_cursor_changed", null] },
        "liveness_mode": { "enum": ["background_sla", "next_turn_only"] }
      }
    },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["worker_id", "last_seen_cursor", "last_discovered_revision", "last_consumed_revision", "last_validated_revision", "active_assignment_id", "origin", "consumed_event_ids"],
        "properties": {
          "worker_id": { "$ref": "#/$defs/id" },
          "last_seen_cursor": { "type": "integer", "minimum": 0 },
          "last_discovered_revision": { "type": "integer", "minimum": 0 },
          "last_consumed_revision": { "type": "integer", "minimum": 0 },
          "last_validated_revision": { "type": "integer", "minimum": 0 },
          "active_assignment_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
          "origin": { "enum": ["coordinator", "user_direct", "external"] },
          "consumed_event_ids": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" }, "uniqueItems": true }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "nonEmpty": { "type": "string", "minLength": 1 }
  }
}
