{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Mr-shanqiu/Coordlane/main/schemas/registry.schema.json",
  "title": "Coordlane stable worker registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "registry_revision", "workers"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "project_id": { "$ref": "#/$defs/id" },
    "registry_revision": { "type": "integer", "minimum": 0 },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["worker_id", "role_id", "thread_id", "host_id", "title", "workspace", "branch", "branch_policy", "capabilities", "status_cursor", "active_assignment_id", "origin", "monitored", "archived", "registry_revision"],
        "properties": {
          "worker_id": { "$ref": "#/$defs/id" },
          "role_id": { "$ref": "#/$defs/id" },
          "thread_id": { "$ref": "#/$defs/nonEmpty" },
          "host_id": { "$ref": "#/$defs/nonEmpty" },
          "title": { "$ref": "#/$defs/nonEmpty" },
          "workspace": { "$ref": "#/$defs/nonEmpty" },
          "branch": { "$ref": "#/$defs/nonEmpty" },
          "branch_policy": { "enum": ["ephemeral-cherry-pick", "persistent-merge"] },
          "capabilities": { "type": "object" },
          "status_cursor": { "type": ["string", "integer", "null"] },
          "active_assignment_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
          "origin": { "enum": ["coordinator", "user_direct", "external", null] },
          "monitored": { "type": "boolean" },
          "archived": { "type": "boolean" },
          "registry_revision": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "nonEmpty": { "type": "string", "minLength": 1 }
  }
}
