{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Mr-shanqiu/Coordlane/main/schemas/report.schema.json",
  "title": "Coordlane durable worker report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "worker_id",
    "assignment_id",
    "attempt_id",
    "ownership_epoch",
    "report_revision",
    "report_digest",
    "content",
    "lifecycle",
    "coordinator_validation", "handoff"
  ],
  "properties": {
    "schema_version": { "const": "1.2.0" },
    "project_id": { "$ref": "#/$defs/id" },
    "worker_id": { "$ref": "#/$defs/id" },
    "assignment_id": { "$ref": "#/$defs/id" },
    "attempt_id": { "$ref": "#/$defs/id" },
    "ownership_epoch": { "type": "integer", "minimum": 1 },
    "report_revision": { "type": "integer", "minimum": 1 },
    "report_digest": { "$ref": "#/$defs/digest" },
    "content": { "$ref": "#/$defs/content" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "coordinator_validation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["disposition", "checks", "report_revision", "report_digest", "subject_head", "validated_at"],
          "properties": {
            "disposition": { "enum": ["accepted", "revision_requested", "rejected"] },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/check" }
            },
            "report_revision": { "type": "integer", "minimum": 1 },
            "report_digest": { "$ref": "#/$defs/digest" },
            "subject_head": { "$ref": "#/$defs/nonEmpty" },
            "validated_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "handoff": { "$ref": "#/$defs/handoff" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "result", "evidence", "subject_head"],
      "properties": {
        "check": { "$ref": "#/$defs/nonEmpty" },
        "command": { "$ref": "#/$defs/nonEmpty" },
        "result": { "enum": ["passed", "failed", "not_run"] },
        "exit_code": { "type": ["integer", "null"] },
        "evidence": { "$ref": "#/$defs/nonEmpty" },
        "subject_head": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "objective",
        "workspace",
        "completed_work",
        "commit",
        "worker_validation",
        "modified_or_owned_files",
        "shared_overlaps",
        "runtime_state",
        "secrets_exposure",
        "blockers",
        "decisions_needed",
        "recommended_next_action", "business_outcome", "diagnostic_shape", "coordination_cost"
      ],
      "properties": {
        "status": { "enum": ["completed", "blocked", "decision_needed", "failed"] },
        "objective": { "$ref": "#/$defs/nonEmpty" },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "branch", "head"],
          "properties": {
            "path": { "$ref": "#/$defs/nonEmpty" },
            "branch": { "$ref": "#/$defs/nonEmpty" },
            "head": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        "completed_work": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmpty" },
          "uniqueItems": true
        },
        "commit": {
          "oneOf": [
            { "$ref": "#/$defs/nonEmpty" },
            { "type": "null" }
          ]
        },
        "no_commit_reason": { "$ref": "#/$defs/nonEmpty" },
        "worker_validation": {
          "type": "array",
          "items": { "$ref": "#/$defs/check" }
        },
        "modified_or_owned_files": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmpty" },
          "uniqueItems": true
        },
        "shared_overlaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmpty" },
          "uniqueItems": true
        },
        "runtime_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["external_side_effects", "running_processes", "switches", "cleanup"],
          "properties": {
            "external_side_effects": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
            "running_processes": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
            "switches": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
            "cleanup": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        "secrets_exposure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "details"],
          "properties": {
            "status": { "enum": ["none", "possible", "confirmed"] },
            "details": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "decisions_needed": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "recommended_next_action": { "$ref": "#/$defs/nonEmpty" }
        ,"business_outcome": { "$ref": "#/$defs/nonEmpty" }
        ,"diagnostic_shape": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "type", "count", "presence"],
            "properties": {
              "path": { "$ref": "#/$defs/nonEmpty" },
              "type": { "enum": ["object", "array", "string", "number", "boolean", "null", "missing"] },
              "count": { "type": "integer", "minimum": 0 },
              "presence": { "enum": ["present", "missing"] }
            }
          }
        }
        ,"coordination_cost": { "$ref": "#/$defs/usage" }
      },
      "allOf": [
        {
          "if": { "properties": { "commit": { "type": "null" } }, "required": ["commit"] },
          "then": { "required": ["no_commit_reason"] },
          "else": { "not": { "required": ["no_commit_reason"] } }
        },
        {
          "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "completed_work": { "type": "array", "minItems": 1 },
              "worker_validation": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/check" },
                    { "type": "object", "properties": { "result": { "const": "passed" } } }
                  ]
                }
              },
              "shared_overlaps": { "type": "array", "maxItems": 0 },
              "blockers": { "type": "array", "maxItems": 0 },
              "decisions_needed": { "type": "array", "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] },
          "then": { "properties": { "blockers": { "type": "array", "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "decision_needed" } }, "required": ["status"] },
          "then": { "properties": { "decisions_needed": { "type": "array", "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": { "properties": { "blockers": { "type": "array", "minItems": 1 } } }
        }
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation_rounds", "test_runs", "external_calls"],
      "properties": {
        "validation_rounds": { "type": "integer", "minimum": 0 },
        "test_runs": { "type": "integer", "minimum": 0 },
        "external_calls": { "type": "integer", "minimum": 0 }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "adjudicated_at", "disposition", "next_action_required", "next_action_assignment_id", "next_action_dispatched_at", "deferred_reason", "deferred_at"],
      "properties": {
        "status": { "enum": ["needs_adjudication", "adjudicated", "next_action_dispatched", "explicitly_deferred"] },
        "adjudicated_at": { "type": ["string", "null"], "format": "date-time" },
        "disposition": { "enum": ["accept", "revise", "reject", "await_decision", "accepted", "revision_requested", "rejected", null] },
        "next_action_required": { "type": ["boolean", "null"] },
        "next_action_assignment_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "next_action_dispatched_at": { "type": ["string", "null"], "format": "date-time" },
        "deferred_reason": { "type": ["string", "null"], "minLength": 1 },
        "deferred_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "durable_at", "notified_at", "discovered_at", "consumed_at", "validated_at", "archived_at"],
      "properties": {
        "status": { "enum": ["building", "durable", "notified", "discovered", "consumed", "validated", "archived"] },
        "durable_at": { "type": ["string", "null"], "format": "date-time" },
        "notified_at": { "type": ["string", "null"], "format": "date-time" },
        "discovered_at": { "type": ["string", "null"], "format": "date-time" },
        "consumed_at": { "type": ["string", "null"], "format": "date-time" },
        "validated_at": { "type": ["string", "null"], "format": "date-time" },
        "archived_at": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
