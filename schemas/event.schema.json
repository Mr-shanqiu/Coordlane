{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Mr-shanqiu/Coordlane/main/schemas/event.schema.json",
  "title": "Coordlane coordinator notification event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "idempotency_key", "sequence", "project_id",
    "worker_id", "thread_id", "host_id", "assignment_id", "event_type",
    "priority", "report_revision", "report_digest", "workspace", "branch",
    "head", "created_at", "requires_user_decision", "status",
    "delivery_attempts", "delivery_id", "delivery_error",
    "delivery_degraded_at", "delivered_at", "acknowledged_at",
    "user_interrupted"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "event_id": { "$ref": "#/$defs/nonEmpty" },
    "idempotency_key": { "$ref": "#/$defs/nonEmpty" },
    "sequence": { "type": "integer", "minimum": 1 },
    "project_id": { "$ref": "#/$defs/id" },
    "worker_id": { "$ref": "#/$defs/id" },
    "thread_id": { "$ref": "#/$defs/nonEmpty" },
    "host_id": { "$ref": "#/$defs/nonEmpty" },
    "assignment_id": { "$ref": "#/$defs/id" },
    "event_type": { "enum": ["completed", "blocked", "decision_needed", "failed"] },
    "priority": { "enum": ["P0", "P1", "P2"] },
    "report_revision": { "type": "integer", "minimum": 1 },
    "report_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "workspace": { "$ref": "#/$defs/nonEmpty" },
    "branch": { "$ref": "#/$defs/nonEmpty" },
    "head": { "$ref": "#/$defs/nonEmpty" },
    "created_at": { "type": "string", "format": "date-time" },
    "requires_user_decision": { "type": "boolean" },
    "status": { "enum": ["pending", "delivered", "acknowledged"] },
    "delivery_attempts": { "type": "integer", "minimum": 0 },
    "delivery_id": { "type": ["string", "null"], "minLength": 1 },
    "delivery_error": { "type": ["string", "null"], "minLength": 1 },
    "delivery_degraded_at": { "type": ["string", "null"], "format": "date-time" },
    "delivered_at": { "type": ["string", "null"], "format": "date-time" },
    "acknowledged_at": { "type": ["string", "null"], "format": "date-time" },
    "user_interrupted": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "delivered" } }, "required": ["status"] },
      "then": {
        "properties": {
          "delivery_attempts": { "type": "integer", "minimum": 1 },
          "delivery_id": { "type": "string", "minLength": 1 },
          "delivered_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    {
      "if": {
        "properties": { "delivery_degraded_at": { "type": "string" } },
        "required": ["delivery_degraded_at"]
      },
      "then": {
        "properties": {
          "delivery_attempts": { "type": "integer", "minimum": 1 },
          "delivery_error": { "type": "string", "minLength": 1 }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "nonEmpty": { "type": "string", "minLength": 1 }
  }
}
