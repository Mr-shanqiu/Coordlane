{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Mr-shanqiu/Coordlane/main/schemas/workstream.schema.json",
  "title": "Coordlane workstream contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "mission_id", "title", "objective",
    "acceptance_criteria", "captain", "crew", "scope_version",
    "ownership_epoch", "workspace", "owned_paths", "forbidden_paths",
    "shared_entrypoints", "dependencies", "gates", "branch_policy",
    "execution_mode", "external_side_effects_allowed",
    "stop_conditions", "status"
  ],
  "properties": {
    "schema_version": { "const": "1.2.0" },
    "id": { "$ref": "#/$defs/id" },
    "mission_id": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/nonEmpty" },
    "objective": { "$ref": "#/$defs/nonEmpty" },
    "acceptance_criteria": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "captain": { "$ref": "#/$defs/id" },
    "crew": { "$ref": "#/$defs/id" },
    "scope_version": { "type": "integer", "minimum": 1 },
    "ownership_epoch": { "type": "integer", "minimum": 1 },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "branch", "baseline_head"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" },
        "branch": { "$ref": "#/$defs/nonEmpty" },
        "baseline_head": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "owned_paths": { "$ref": "#/$defs/uniqueStrings" },
    "forbidden_paths": { "$ref": "#/$defs/uniqueStrings" },
    "shared_entrypoints": { "$ref": "#/$defs/uniqueStrings" },
    "dependencies": { "$ref": "#/$defs/uniqueIds" },
    "gates": { "$ref": "#/$defs/uniqueIds" },
    "branch_policy": { "enum": ["ephemeral-cherry-pick", "persistent-merge"] },
    "execution_mode": { "enum": ["write", "read_only", "skeleton"] },
    "external_side_effects_allowed": { "type": "boolean" },
    "allowed_side_effects": { "$ref": "#/$defs/uniqueStrings" },
    "stop_conditions": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "status": {
      "enum": ["planned", "ready", "active", "completed", "blocked", "decision_needed", "failed", "superseded", "stale"]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "external_side_effects_allowed": { "const": true } }, "required": ["external_side_effects_allowed"] },
      "then": { "required": ["allowed_side_effects"], "properties": { "allowed_side_effects": { "type": "array", "minItems": 1 } } },
      "else": { "not": { "required": ["allowed_side_effects"] } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "uniqueStrings": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" }, "uniqueItems": true },
    "nonEmptyUniqueStrings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" }, "uniqueItems": true },
    "uniqueIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
  }
}
