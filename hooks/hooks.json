{
  "description": "Observe isolated Crew dispatch and durable completion without background polling.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/coordlane-core.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking Coordlane inbox"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/coordlane-core.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking Coordlane assignment boundary"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*send_message_to_thread$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/coordlane-core.mjs\"",
            "timeout": 5,
            "statusMessage": "Recording Coordlane delivery"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/coordlane-core.mjs\"",
            "timeout": 5,
            "statusMessage": "Saving Coordlane result"
          }
        ]
      }
    ]
  }
}
