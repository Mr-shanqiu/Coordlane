{
  "description": "Keep the Captain responsive and enforce Coordlane scan, approval-attention, terminal report, and one-shot notification gates.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/coordlane-hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Starting Coordlane turn gate"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/coordlane-hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking Coordlane Captain availability and turn-entry gates"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/coordlane-hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Recording Coordlane approval attention"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(send_message_to_thread|wait_threads)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/coordlane-hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Recording Coordlane delivery"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/coordlane-hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking Coordlane terminal gate"
          }
        ]
      }
    ]
  }
}
